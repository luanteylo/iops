#!/bin/bash
# Stub benchmark for trying out the staircase search without a real code.
# Each problem size needs four times as many blocks as the one before it:
#   1000 -> 1    2000 -> 4    3000 -> 16    4000 -> 64
size=0
blocks=0
while [ $# -gt 0 ]; do
  case "$1" in
    --size)   size=$2;   shift 2;;
    --blocks) blocks=$2; shift 2;;
    *) shift;;
  esac
done

steps=$(( size / 1000 ))
needed=1
for _ in $(seq 2 "$steps"); do
  needed=$(( needed * 4 ))
done

echo "size=$size blocks=$blocks needed=$needed"
[ "$blocks" -ge "$needed" ]
